{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "invitacion-yoshi",
  "compatibility_date": "2026-10-22",
  // Worker solo para /medios/* (respuestas por partes para iPhone); lo demás son estáticos de dist/
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/medios/*"]
  }
}
