---
import '@fontsource/lilita-one/latin-400.css';
import '@fontsource/barlow-condensed/latin-600.css';
import '@fontsource/barlow-condensed/latin-700.css';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/animaciones.css';
// La intro usa Barlow Condensed Bold y Lilita One: se precargan para que no parpadeen
import barlow700 from '@fontsource/barlow-condensed/files/barlow-condensed-latin-700-normal.woff2?url';
import lilita400 from '@fontsource/lilita-one/files/lilita-one-latin-400-normal.woff2?url';

import Fondo from '../components/Fondo.astro';
import Intro from '../components/Intro.astro';
import Heroe from '../components/Heroe.astro';
import BotonGuia from '../components/BotonGuia.astro';
import FondoInferior from '../components/FondoInferior.astro';
import Mensaje from '../components/Mensaje.astro';
import Detalles from '../components/Detalles.astro';
import Cierre from '../components/Cierre.astro';
import Musica from '../components/Musica.astro';

import separador from '../assets/svg/separador.svg';

import { evento } from '../data/evento';
import { readFileSync } from 'node:fs';
import { createHash } from 'node:crypto';

const sitio = Astro.site ?? new URL(Astro.url.origin);
// Versión según el contenido: WhatsApp y Facebook guardan la imagen por URL, así que si cambia, cambia la URL
const ogVersion = createHash('sha1').update(readFileSync('public/og-image.jpg')).digest('hex').slice(0, 8);
const ogImagen = new URL(`/og-image.jpg?v=${ogVersion}`, sitio).href;
const ogUrl = new URL('/', sitio).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{evento.titulo}</title>
    <meta name="description" content={evento.descripcion} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Con JavaScript, lo que se revela al hacer scroll empieza oculto (ver animaciones.css) -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="preload" href={barlow700} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={lilita400} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:site_name" content={evento.titulo} />
    <meta property="og:title" content={evento.titulo} />
    <meta property="og:description" content={evento.descripcion} />
    <meta property="og:image" content={ogImagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content="CumpleMania de Eduardo" />
    <meta property="og:locale" content="es_SV" />
    <meta name="twitter:card" content="summary_large_image" />

    <noscript>
      <style>
        .intro { display: none !important; }
        .home { opacity: 1 !important; pointer-events: auto !important; }
        body.bloqueado { overflow: auto !important; }
      </style>
    </noscript>
  </head>
  <body class="bloqueado">
    <Fondo />
    <Intro />

    <!-- Home (frame "Invitacion 2" 280:519 de Figma, 412 × 2281). El DOM va en orden de lectura; el orden de
         capas de Figma lo da --z: fondo inferior 1 · héroe 2 · mensaje y columna 3 · botón guía 4 -->
    <main class="home" id="home" inert tabindex="-1">
      <h1 class="solo-lectores">{evento.titulo}</h1>
      <Heroe />
      <BotonGuia />
      <FondoInferior />
      <Mensaje />
      <!-- 280:643 · columna: placa, datos, separador y cierre, con 51 de separación -->
      <div class="columna abs" style="--x:0;--y:1141;--w:412;--z:3">
        <Detalles />
        <img class="columna__separador" src={separador.src} alt="" width={separador.width} height={separador.height} data-revelar />
        <Cierre />
      </div>
    </main>

    <Musica />

    <script>
      import '../scripts/intro';
    </script>
  </body>
</html>

<style>
  .home {
    --k: var(--u);
    position: relative;
    z-index: 20;
    width: var(--ancho);
    height: calc(2281 * var(--k));
    margin: 0 auto;
    background: var(--fondo-home);
    overflow: hidden; /* respaldo para Safari < 16 */
    overflow: clip;
    opacity: 0;
    pointer-events: none;
    outline: none;
  }
  /* Con JavaScript, el Home no se renderiza hasta que la intro terminó de cargar (intro.ts agrega
     .cargado): así sus imágenes, todas diferidas, no le quitan ancho de banda a la intro.
     Tiene alto fijo, por eso no hay saltos de layout al mostrarlo. */
  :global(html.js) .home:not(.cargado) {
    content-visibility: hidden;
  }
  .home.visible {
    opacity: 1;
    pointer-events: auto;
    transition: opacity var(--dur-dissolve) var(--ease-out);
  }
  .columna {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(51 * var(--k));
  }
  .columna__separador {
    width: calc(356.723 * var(--k));
    height: calc(12.894 * var(--k));
  }
  .columna__separador:global(.revelado) {
    animation: encender 500ms var(--ease-out) both;
  }
  /* Tablet y escritorio: la invitación es una tarjeta sobre el estadio desenfocado (como Katalina) */
  @media (min-width: 600px) {
    .home {
      margin: clamp(24px, 5vh, 56px) auto;
      border-radius: calc(28 * var(--k));
      box-shadow:
        0 30px 80px -24px rgba(0, 0, 0, 0.75),
        0 8px 28px -10px rgba(255, 192, 61, 0.22),
        0 0 0 1px rgba(255, 255, 255, 0.12);
    }
  }
</style>
