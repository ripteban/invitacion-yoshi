---
// Cierre (72:86): agua con pato recortada a 412 × 759, "¡Que no falten las risas!" (72:160, −3°)
// y "Nos vemos en la fiesta." (72:162). Las coordenadas de los hijos son absolutas del frame.
import Img from './Img.astro';
import VideoFondo from './VideoFondo.astro';
import agua from '../assets/home/cierre.png';
import { evento } from '../data/evento';
---

<section class="cierre seccion" style="--top:1254.67;--z:3" aria-label="Cierre">
  <!-- relleno 1080 × 1920 en "cover" sobre 412 × 759: se ve de 426.94 px de diseño de ancho;
       va debajo del video, así que basta calidad 75 -->
  <Img src={agua} ancho={426.94} class="abs cubrir" calidad={75} style="--x:0;--y:1254.67;--w:412;--h:759" />
  <VideoFondo nombre="fondo-cierre" fondo="home" class="abs" style="--x:0;--y:1254.67;--w:412;--h:759" />

  <h2 class="titulo lilita abs" style="--x:27.32;--y:1701.65;--w:357.955;--h:141.254" data-revelar>
    <span>{evento.cierre[0]}</span>
    <span>{evento.cierre[1]}</span>
  </h2>
  <p class="subtitulo lilita abs" style="--x:0.2;--y:1858.34;--w:412;--h:29.064" data-revelar>{evento.subcierre}</p>
</section>

<style>
  .cierre {
    height: calc(759 * var(--k));
    overflow: clip;
  }
  .titulo {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin: 0;
    rotate: -3deg;
    color: var(--blanco);
    font-size: calc(61.902 * var(--k));
    line-height: calc(61.283 * var(--k));
    letter-spacing: calc(-1.5476 * var(--k));
    text-align: center;
    text-shadow: var(--sombra-cierre);
    white-space: nowrap;
  }
  .subtitulo {
    color: var(--blanco);
    font-size: calc(27.68 * var(--k));
    line-height: calc(29.064 * var(--k));
    text-align: center;
    text-shadow: var(--sombra-subcierre);
    white-space: nowrap;
  }

  /* Al revelarse: el título aparece tambaleándose alrededor de sus −3° y luego late muy leve;
     el subtítulo entra 150 ms después */
  .titulo:global(.revelado) {
    --base: -3deg;
    --escala: 1.02;
    animation:
      tambalear 900ms var(--ease-out) both,
      respirar 2.4s ease-in-out 900ms infinite;
  }
  .subtitulo:global(.revelado) {
    --subir: 14;
    animation: aparecer-subiendo 600ms var(--ease-out) 150ms both;
  }
  @media (prefers-reduced-motion: reduce) {
    .titulo:global(.revelado),
    .subtitulo:global(.revelado) {
      animation: encender 400ms var(--ease-out) both;
    }
  }
</style>
