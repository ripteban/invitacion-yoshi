---
// Fondo del estadio (relleno 257:283 de la intro), fijo detrás de todo. Igual que la seda de Katalina:
// - Móvil: se ve en la intro; al abrir lo tapa la invitación.
// - Tablet / escritorio: sigue visible a los lados de la tarjeta, desenfocado y con un velo oscuro.
import Img from './Img.astro';
import estadio from '../assets/intro/estadio.png';
---

<div class="fondo" id="fondo" aria-hidden="true">
  <div class="fondo__medio">
    <Img src={estadio} ancho={412} class="llenar cubrir" calidad={85} sizes="max(100vw, 44.93vh)" eager />
  </div>
</div>

<style>
  .fondo {
    position: fixed;
    inset: 0;
    z-index: 0;
    background: var(--negro);
    overflow: hidden;
    pointer-events: none;
  }
  .fondo__medio {
    position: absolute;
    inset: 0;
  }
  /* Tablet / escritorio, ya abierta la invitación: desenfoque y velo dan profundidad a la tarjeta.
     La escala esconde los bordes difusos del desenfoque. */
  @media (min-width: 600px) {
    .fondo__medio {
      transition:
        filter 600ms var(--ease-out),
        scale 600ms var(--ease-out);
    }
    .fondo::after {
      content: '';
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.35);
      opacity: 0;
      transition: opacity 600ms var(--ease-out);
    }
    :global(body:not(.bloqueado)) .fondo__medio {
      filter: blur(6px) saturate(1.05);
      scale: 1.06;
    }
    :global(body:not(.bloqueado)) .fondo::after {
      opacity: 1;
    }
  }
</style>
