---
// Bolsa DIANA (nodo 22:115) + mano que invita a tocar (22:161).
// La bolsa es un botón real: tocarla abre la invitación, igual que el botón amarillo.
// Los chicharrones voladores (scripts/chicharrones.ts) se crean al tocar, a partir de estos WebP
// con alfa: se pasan en data-chicharrones y se precargan con baja prioridad al cargar la página.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Img from './Img.astro';
import bolsa from '../assets/intro/bolsa.png';
import mano from '../assets/svg/mano.svg';

// Cada pieza se ve de hasta 140 u × 1.3 (≈ 182 px de diseño): WebP de 400 px ≈ 2.2×
const archivos = import.meta.glob<{ default: ImageMetadata }>('../assets/chicharrones/chicharron-*.png', { eager: true });
const chicharrones = await Promise.all(
  Object.keys(archivos)
    .sort()
    .map(async (ruta) => {
      const src = archivos[ruta].default;
      const img = await getImage({ src, width: Math.min(400, src.width), format: 'webp', quality: 80 });
      return { src: img.src, proporcion: +(src.height / src.width).toFixed(4) };
    }),
);
---

<button
  class="bolsa abs anim-flotar"
  type="button"
  aria-label="Abrir la bolsa de chicharrones"
  style="--x:40.714;--y:315.329;--w:330.572;--h:428.132"
  data-chicharrones={JSON.stringify(chicharrones)}
>
  <!-- En Figma la imagen (0.761) llena la caja (0.772) en modo "cover", sin deformarse -->
  <Img src={bolsa} ancho={330.572} escala="intro" calidad={90} class="llenar cubrir" eager />
</button>
<img class="mano abs anim-tocar" src={mano.src} alt="" width={mano.width} height={mano.height} style="--x:268.028;--y:612.203;--w:73.791;--h:90.797" />

<style>
  .bolsa {
    cursor: pointer;
  }
  .bolsa:focus-visible {
    outline: calc(3 * var(--k)) solid var(--navy);
    outline-offset: calc(4 * var(--k));
  }
  .mano {
    pointer-events: none;
  }
</style>
