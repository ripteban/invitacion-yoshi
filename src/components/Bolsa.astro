---
// Bolsa DIANA (nodo 22:115) + mano que invita a tocar (22:161).
// La bolsa es un botón real: tocarla abre la invitación, igual que el botón amarillo.
// La capa de chicharrones voladores llega en la Fase 3.
import Img from './Img.astro';
import bolsa from '../assets/intro/bolsa.png';
import mano from '../assets/svg/mano.svg';
---

<button class="bolsa abs" type="button" aria-label="Abrir la bolsa de chicharrones" style="--x:40.714;--y:315.329;--w:330.572;--h:428.132">
  <Img src={bolsa} ancho={330.572} escala="intro" calidad={90} eager />
</button>
<img class="mano abs" src={mano.src} alt="" width={mano.width} height={mano.height} style="--x:268.028;--y:612.203;--w:73.791;--h:90.797" />

<style>
  .bolsa {
    cursor: pointer;
  }
  .bolsa:focus-visible {
    outline: calc(3 * var(--k)) solid var(--navy);
    outline-offset: calc(4 * var(--k));
  }
  .mano {
    pointer-events: none;
  }
</style>
