---
// Silueta del campeón (257:492, 366.243 × 528.633): botón que abre la invitación ("Revela el campeón").
// En Figma la imagen va en modo multiplicar sobre el estadio y se desvanece hacia abajo (máscara 0 → 1 a la mitad).
// La mezcla va en el botón: es lo que se compone sobre el estadio de la intro (Intro.astro).
// Las W voladoras (scripts/chicharrones.ts) se crean al tocar, a partir de los WebP de data-chicharrones.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Img from './Img.astro';
import silueta from '../assets/intro/silueta.png';
import mano from '../assets/svg/mano.svg';

// Cada pieza se ve de hasta 140 u × 1.3 (≈ 182 px de diseño): WebP de 400 px ≈ 2.2×
const archivos = import.meta.glob<{ default: ImageMetadata }>('../assets/chicharrones/chicharron-*.png', { eager: true });
const piezas = await Promise.all(
  Object.keys(archivos)
    .sort()
    .map(async (ruta) => {
      const src = archivos[ruta].default;
      const img = await getImage({ src, width: Math.min(400, src.width), format: 'webp', quality: 80 });
      return { src: img.src, proporcion: +(src.height / src.width).toFixed(4) };
    }),
);
---

<button
  class="silueta abs anim-flotar"
  type="button"
  aria-label="Revelar al campeón"
  style="--x:22.879;--y:226.132;--w:366.243;--h:528.633;--giro:0.8deg"
  data-chicharrones={JSON.stringify(piezas)}
>
  <span class="silueta__imagen">
    <Img src={silueta} ancho={366.243} escala="intro" calidad={85} class="llenar cubrir" eager />
  </span>
</button>
<img class="mano abs anim-tocar" src={mano.src} alt="" width={mano.width} height={mano.height} style="--x:268.028;--y:612.203;--w:73.791;--h:90.797" />

<style>
  .silueta {
    overflow: hidden; /* respaldo para Safari < 16 */
    overflow: clip;
    cursor: pointer;
    mix-blend-mode: multiply;
  }
  .silueta__imagen {
    position: absolute;
    inset: 0;
    -webkit-mask-image: linear-gradient(to top, transparent 0%, #000 50%);
    mask-image: linear-gradient(to top, transparent 0%, #000 50%);
  }
  .silueta:focus-visible {
    outline: calc(3 * var(--k)) solid var(--texto);
    outline-offset: calc(4 * var(--k));
  }
  .mano {
    pointer-events: none;
  }
  /* Con mouse: la silueta se acerca al pasar el cursor */
  @media (hover: hover) and (pointer: fine) {
    .silueta {
      transition: scale 400ms var(--ease-gentle);
    }
    .silueta:hover:not(:disabled) {
      scale: 1.03;
    }
  }
</style>
