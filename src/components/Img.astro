---
// Imagen optimizada: WebP de alta calidad en varios anchos; el navegador elige según el tamaño real
// en pantalla (sizes), que depende del breakpoint (ver tokens.css) y de la densidad del teléfono.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  /** ancho de diseño en Figma (px) */
  ancho: number;
  alt?: string;
  calidad?: number;
  class?: string;
  style?: string;
  eager?: boolean;
  /** 'home' escala con --u (ancho de la invitación); 'intro' escala con --ui (ancho y alto de pantalla) */
  escala?: 'home' | 'intro';
  /** reemplaza el "sizes" calculado (p. ej. fondos que cubren toda la pantalla) */
  sizes?: string;
}

const { src, ancho, alt = '', calidad = 80, class: clase = 'llenar', style, eager = false, escala = 'home', sizes: sizesFijo } = Astro.props;

const r = Math.round;
// 1× … 4× del ancho de diseño, sin pasar del original. Los pasos intermedios cubren las densidades
// comunes de Android (1.75, 2.625…), así no se baja una imagen mucho más grande de lo que se ve.
const anchos = [...new Set([1, 1.25, 1.5, 1.75, 2, 2.5, 3, 4].map((m) => Math.min(src.width, r(ancho * m))))];
const vw = ((ancho / 412) * 100).toFixed(2);
// Debe coincidir con --u y --ui de tokens.css (solo móvil; la Fase 5 agrega tablet y escritorio)
const vh = ((ancho / 917) * 100).toFixed(2);
const sizes = sizesFijo ?? (escala === 'intro' ? `min(${vw}vw, ${vh}vh)` : `${vw}vw`);
const w = Math.min(src.width, r(ancho));
const alto = r((src.height * w) / src.width);
---

<picture class={clase} style={style}>
  <Image
    src={src}
    alt={alt}
    width={w}
    height={alto}
    widths={anchos}
    sizes={sizes}
    format="webp"
    quality={calidad}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={eager ? 'high' : undefined}
    draggable="false"
  />
</picture>
