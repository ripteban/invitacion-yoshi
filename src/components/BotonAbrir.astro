---
// Botón "Haz click para revelar" (placa 257:503, sin bisel exterior: en Figma está oculto) con flecha.
import Placa from './Placa.astro';
import flecha from '../assets/svg/flecha-arriba.svg';
import { evento } from '../data/evento';
---

<Placa as="button" conBisel={false} id="boton-abrir" class="boton anim-respirar" style="--x:27.64;--y:790.765;--escala:1.03;--dur:1.8s">
  <span class="boton__texto barlow">{evento.boton}</span>
  <img class="boton__flecha anim-flotar-suave" style="--alto:1.5;--dur:1.2s" src={flecha.src} alt="" width={flecha.width} height={flecha.height} />
</Placa>

<style>
  .boton__texto {
    /* Centrado 17.82 a la izquierda del centro de la placa, como en Figma */
    position: absolute;
    left: 50%;
    top: calc(26.602 * var(--k));
    translate: calc(-50% - 17.82 * var(--k)) 0;
    color: var(--texto);
    font-size: calc(32.067 * var(--k));
    line-height: calc(27.257 * var(--k));
    white-space: nowrap;
  }
  .boton__flecha {
    position: absolute;
    left: calc(306.363 * var(--k));
    top: calc(30.592 * var(--k));
    width: calc(16.319 * var(--k));
    height: calc(20.02 * var(--k));
  }
  :global(#boton-abrir) {
    cursor: pointer;
  }
  :global(#boton-abrir:focus-visible) {
    outline: calc(3 * var(--k)) solid var(--texto);
    outline-offset: calc(3 * var(--k));
  }
  /* Con mouse: el botón se eleva (translate no choca con el pulso, que usa scale) */
  @media (hover: hover) and (pointer: fine) {
    :global(#boton-abrir) {
      transition: translate 200ms var(--ease-out);
    }
    :global(#boton-abrir:hover:not(:disabled)) {
      translate: 0 calc(-2 * var(--k));
    }
  }
</style>
