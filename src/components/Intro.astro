---
// Intro (frame "Inicio" 257:282 de Figma, 412 × 917): revelar al campeón.
// El lienzo escala con --ui para caber completo en ancho y alto. El estadio va dentro de la intro (además de
// Fondo.astro) para que la silueta se multiplique sobre él, como en Figma.
import Img from './Img.astro';
import Placa from './Placa.astro';
import Silueta from './Silueta.astro';
import BotonAbrir from './BotonAbrir.astro';
import estadio from '../assets/intro/estadio.png';
import { evento } from '../data/evento';
---

<section class="intro" id="intro" aria-label="Abrir la invitación">
  <!-- 257:283 · render de Figma del fondo (412 × 917), en "cover" a pantalla completa -->
  <Img src={estadio} ancho={412} class="llenar cubrir" calidad={85} sizes="max(100vw, 44.93vh)" eager />

  <div class="intro__lienzo">
    <!-- 257:311 · placa del título -->
    <Placa class="titulo-intro" style="--x:27.64;--y:45.03">
      <p class="titulo-intro__texto barlow">{evento.tituloIntro}</p>
    </Placa>

    <!-- 257:288 · instrucción, rotada −2° -->
    <p class="instruccion lilita abs" style="--x:19.16;--y:134.888;--w:373.609;--h:55.245">
      <span>{evento.instruccion[0]}</span>
      <span>{evento.instruccion[1]}</span>
    </p>

    <Silueta />
    <BotonAbrir />
  </div>
</section>

<style>
  .intro {
    --k: var(--ui);
    position: fixed;
    inset: 0;
    z-index: 40;
    display: grid;
    place-items: center;
    background: var(--fondo-intro);
    overflow: hidden;
  }
  .intro__lienzo {
    position: relative;
    width: calc(412 * var(--k));
    height: calc(917 * var(--k));
  }
  .titulo-intro__texto {
    position: absolute;
    left: 50%;
    top: calc(19 * var(--k));
    translate: calc(-50% + 0.5 * var(--k)) 0;
    color: var(--texto);
    font-size: calc(44.886 * var(--k));
    line-height: calc(38.153 * var(--k));
    white-space: nowrap;
  }
  /* Rebote leve de entrada al cargar */
  .intro :global(.titulo-intro) {
    animation: entrar-escala var(--dur-gentle) var(--ease-gentle) 150ms both;
  }
  /* Al abrir, los bucles se congelan en su pose actual para que GSAP siga desde ahí sin saltos */
  .intro.abriendo :global(:is(.anim-flotar, .anim-flotar-suave, .anim-respirar, .anim-tocar)) {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .intro :global(.titulo-intro) {
      animation: none;
    }
  }
  /* Capas de piezas voladoras (las crea scripts/chicharrones.ts al tocar) */
  :global(.chicharrones) {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  /* Atrás: dentro del lienzo, levemente desenfocadas. El desenfoque va en cada pieza (capa propia por
     will-change): en toda la capa obligaba a repintarla en cada cuadro. */
  :global(.chicharrones--detras .chicharron) {
    filter: blur(calc(1.5 * var(--k)));
  }
  /* Adelante: sobre todo y fija, para seguir cruzando mientras aparece el Home */
  :global(.chicharrones--delante) {
    position: fixed;
    z-index: 50;
    overflow: hidden;
  }
  .instruccion {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    rotate: -2deg;
    color: var(--blanco);
    font-size: calc(28.84 * var(--k));
    line-height: calc(27.398 * var(--k));
    text-align: center;
    white-space: nowrap;
  }
</style>
